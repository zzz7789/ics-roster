# 团队整表订阅 token，部署前务必改成随机串
ICS_ROSTER_TEAM_TOKEN=change-me-team-token

# 允许跨域访问的前端地址，同域部署可留空
ICS_ROSTER_CORS=

# SQLite 数据文件位置（docker 内为 /data/ics-roster.db）
# ICS_ROSTER_DB=/data/ics-roster.db

# 管理员账号（首次启动创建；密码留空则随机生成并打印到日志）
ICS_ROSTER_ADMIN_USER=admin
ICS_ROSTER_ADMIN_PASSWORD=

# 登录会话有效期（天）
ICS_ROSTER_SESSION_DAYS=7

# 会话签名密钥，留空自动生成到 data/secret.key
# ICS_ROSTER_SECRET=
